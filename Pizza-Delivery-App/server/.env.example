PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/pizza_delivery_app
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=2h

# Seed a separate admin account on server startup. Do not use these example values.
ADMIN_NAME=Pizza Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_long_unique_password

# Razorpay TEST MODE keys only for local development
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# SMTP is optional in development. Without it, verification/reset URLs are returned by API.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Pizza App <no-reply@example.com>
ADMIN_NOTIFICATION_EMAIL=admin@example.com
LOW_STOCK_CHECK_CRON=*/5 * * * *
PENDING_ORDER_EXPIRY_MINUTES=30
